[Unit]
Description=MCHOSE Ace68-II advanced-key bridge
Documentation=https://github.com/muralibaburaj/mchose-ace68-ii-linux
# Not Requires=: the daemon is happy to run before the keyboard exists and
# waits for it to appear.
After=systemd-udevd.service systemd-modules-load.service

[Service]
Type=simple
ExecStart=@BIN@ --retry 2
# The device legitimately disappears while it is passed through to a VM, and
# reappears on detach. Restarting keeps the bridge alive across that.
Restart=always
RestartSec=2
# Realtime-ish priority: this sits in the input path.
Nice=-5

[Install]
WantedBy=multi-user.target
