# MCHOSE Ace68-II (41e4:2116): read/write WebHID access on all interfaces.
# uaccess grants the active seat access; wheel covers systems where logind
# grants the greeter (e.g. sddm) the ACL instead of the desktop session.
# The bridge can still read interface 2 when running as root.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="41e4", ATTRS{idProduct}=="2116", MODE="0660", GROUP="wheel", TAG+="uaccess"
